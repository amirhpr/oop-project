    def add_employee(self, first_name: str, last_name: str, age: int):
        employee = {
            "first_name": first_name,
            "last_name": last_name,
            "age": age
        }
        self.employees.append(employee)
    def total_value(self) -> int:
        total = 0
        for drug in self.drugs:
            total += drug['amount'] * drug['price']
        return total
    def employees_summary(self) -> str:
        summary = "Employees:\n"
        for i, employee in enumerate(self.employees, start=1):
            summary += f"The employee number {i} is {employee['first_name']} {employee['last_name']} who is {employee['age']} years old.\n"
        return summary 
